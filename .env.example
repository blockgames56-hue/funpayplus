# Пример переменных окружения FunPay Plus (Docker / VPS).
# Скопируйте в .env и замените значения: cp .env.example .env
# deploy/setup.sh создаёт .env со случайными ключами автоматически.
# Новая установка: sudo bash install.sh --domain panel.example.com
COMPOSE_PROJECT_NAME=funpay-plus

# Пароль PostgreSQL (обязательно, случайная строка)
DB_PASSWORD=change-me-random-hex

# Ключ шифрования секретов (обязательно, случайная строка).
# Перенос установки: тот же SECRET_KEY, что на старом сервере, иначе
# сохранённые golden_key/пароли не расшифруются.
SECRET_KEY=change-me-random-hex

# Ключ входа в терминал (обязательно). Используется в окне входа
# и как Bearer-токен API. Не путать с golden_key FunPay.
API_TOKEN=change-me-random-hex

# Порт и адрес публикации фронтенда (по умолчанию доступ только с сервера)
PORT=8080
BIND_ADDRESS=127.0.0.1

# Публичный адрес панели (для HTTPS/домена). Пример: https://terminal.example.com
# SECURE_COOKIE=true включайте только вместе с HTTPS-доменом.
PUBLIC_ORIGIN=
SECURE_COOKIE=false

# Домен для Caddy (только с deploy/compose.https.yml)
# DOMAIN=terminal.example.com

# Дополнительные разрешённые Origin через запятую (необязательно).
# Origin'ы десктоп-приложения (tauri://localhost, http://tauri.localhost)
# разрешены всегда и добавляются автоматически.
# ALLOWED_ORIGINS=

# Транспорт FunPay-клиента: httpx (по умолчанию) или requests
FUNPAY_TRANSPORT=httpx
